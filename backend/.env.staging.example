# ==============================================================================
# CONTRACTLY STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` in the staging environment. Never commit real credential values.
# ==============================================================================

# --- Platform & Security ---
ENVIRONMENT=staging
DEBUG=false
# Generate a cryptographically random secret with at least 32 characters
SECRET_KEY=generate_staging_secret_key_at_least_32_chars_long_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_MAX_LIFETIME_DAYS=30
SECURE_COOKIES=true
APP_BASE_URL=https://staging.contractly.internal
ALLOWED_ORIGINS=["https://staging.contractly.internal"]

# --- Staging Relational Database (PostgreSQL) ---
# Dedicated isolated staging PostgreSQL instance (never use production DB)
DATABASE_URL=postgresql+asyncpg://contractly_staging_user:STAGING_DB_PASSWORD@staging-db.internal:5432/contractly_staging
ALEMBIC_DATABASE_URL=postgresql+asyncpg://contractly_staging_user:STAGING_DB_PASSWORD@staging-db.internal:5432/contractly_staging
AUTO_CREATE_TABLES=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30.0
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true

# --- Distributed Cache & Rate Limiting (Redis) ---
# Dedicated staging Redis service for atomic cross-worker rate limiting
REDIS_URL=redis://:STAGING_REDIS_PASSWORD@staging-redis.internal:6379/0
REDIS_REQUIRED=true
REDIS_CONNECT_TIMEOUT_SECONDS=3.0
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_REGISTER_WINDOW_SECONDS=300
AUTH_IP_MAX_REQUESTS_PER_MINUTE=60

# --- Cloud Document Object Storage (S3 / Cloud Storage) ---
# Dedicated staging S3 bucket with server-side encryption and restricted IAM credentials
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=contractly-staging-documents
S3_REGION_NAME=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=STAGING_AWS_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=STAGING_AWS_SECRET_ACCESS_KEY
S3_SSE_ALGORITHM=AES256
S3_PRESIGNED_EXPIRATION_SECONDS=900
MAX_UPLOAD_SIZE_BYTES=52428800

# --- Transactional Email Delivery (SMTP Relay) ---
# Staging SMTP provider using verified test domains and authorized recipients
EMAIL_SERVICE_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=STAGING_SMTP_API_KEY
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS="Contractly Staging <notifications@staging.contractly.internal>"
EMAIL_TIMEOUT_SECONDS=10.0
EMAIL_MAX_RETRIES=2
ENFORCE_EMAIL_VERIFICATION=false

# --- AI Intelligence & Q&A (Google Gemini) ---
# Staging Gemini API key with billing alerts and spending quota caps
GEMINI_API_KEY=STAGING_GEMINI_API_KEY
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=35.0
GEMINI_MAX_QUESTION_LENGTH=1000

# --- Autonomous Background Scheduler ---
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_INTERVAL_HOURS=12.0
NOTIFICATION_SCHEDULER_INITIAL_DELAY_SECONDS=10.0
